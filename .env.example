# Required: create a Telegram bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Required: https://pokemontcgapi.com/free-api-key (verify your email).
PTCG_API_KEY=
# English is the only interface language in this release.
BOT_LANG=en
# Optional API endpoint override.
PTCG_API_BASE=https://api.pokemontcgapi.com/v1
# Optional: owner's positive Telegram user/private chat ID; /quota is private-only.
ADMIN_CHAT_ID=
