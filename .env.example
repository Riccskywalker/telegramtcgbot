# --- RareBit Telegram bot · configurazione ---
# Copia in .env e compila. L'unico valore obbligatorio è il token.

# Token del bot (da @BotFather). Lo passi più tardi.
RAREBIT_BOT_TOKEN=

# API pubblica RareBit (non serve auth per il catalogo)
RAREBIT_API_BASE=https://api.rarebit.app/api
RAREBIT_SITE_BASE=https://rarebit.app

# Lingua dei link verso il sito (it/en/de/fr/es/ja). La copy del bot è IT.
RAREBIT_LOCALE=it

# Valuta di display dei prezzi: l'API dà la valuta della fonte (spesso USD per
# il Giappone), il bot converte via tassi BCE. EUR consigliato per i gruppi IT.
RAREBIT_DISPLAY_CURRENCY=EUR

# Lingua di default del prezzo quando l'utente NON mette un tag (EN/IT/…).
#   en = mostra il prezzo Cardmarket inglese [default]
#   (vuoto) = mostra il valore corrente = global-lowest tra le lingue
# Un tag esplicito nella query ha sempre la precedenza. Le carte senza quella
# lingua (es. JP) ripiegano sul valore corrente.
RAREBIT_DEFAULT_LANGUAGE=en

# Come mostrare l'immagine della carta nei messaggi: preview | photo | none
#   preview = anteprima link sopra il testo (leggera, group-friendly) [default]
#   photo   = manda la foto vera (più invasiva nei gruppi)
#   none    = solo testo
RAREBIT_IMAGE_MODE=preview

# Tracciamento: parametri UTM aggiunti ai link verso rarebit.app (vuoto = off)
RAREBIT_UTM=utm_source=telegram&utm_medium=bot&utm_campaign=lookup

# Performance / robustezza
RAREBIT_CACHE_TTL=120
RAREBIT_HTTP_TIMEOUT=8
RAREBIT_INLINE_LIMIT=10
RAREBIT_COMMAND_RESULTS=6
# quante alternative mostrare sotto la scheda (bottoni), oltre al risultato top
RAREBIT_MAX_ALTS=5

# Logging: DEBUG | INFO | WARNING | ERROR
RAREBIT_LOG_LEVEL=INFO

# File JSON dove il bot ricorda i gruppi/canali in cui è stato aggiunto
# (popolato dagli update my_chat_member; serve al digest top-movers per sapere
# dove postare). Su VPS punta a un path persistente, es. /opt/rarebit-bot/groups.json
RAREBIT_GROUPS_STORE=groups.json
