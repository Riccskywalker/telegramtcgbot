[Unit]
Description=RareBit Telegram bot (price lookup)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# il token e la config si leggono da /opt/rarebit-bot/.env (python-dotenv)
WorkingDirectory=/opt/rarebit-bot
ExecStart=/opt/rarebit-bot/.venv/bin/python -m rarebit_bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
